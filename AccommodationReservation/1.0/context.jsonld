{
  "@context": {
    "schema": "https://schema.org/",
    "ares": "https://schema.beckn.io/AccommodationReservation#",
    "AccommodationReservation": "ares:AccommodationReservation",
    "bookingReference": { "@id": "ares:bookingReference" },
    "agentReference": { "@id": "ares:agentReference" },
    "networkConfirmationRef": { "@id": "ares:networkConfirmationRef" },
    "propertyConfirmationRef": { "@id": "ares:propertyConfirmationRef" },
    "reservationStatus": { "@id": "ares:reservationStatus" },
    "bookingDate": { "@id": "schema:bookingTime" },
    "cancellationDeadline": { "@id": "ares:cancellationDeadline" },
    "totalChargeAmount": { "@id": "schema:price" },
    "grossAmount": { "@id": "ares:grossAmount" },
    "chargeCurrency": { "@id": "schema:priceCurrency" },
    "leadSalutation": { "@id": "schema:honorificPrefix" },
    "leadFirstName": { "@id": "schema:givenName" },
    "leadLastName": { "@id": "schema:familyName" },
    "localPropertyId": { "@id": "ares:localPropertyId" },
    "propertyName": { "@id": "schema:name" },
    "propertyAddress": { "@id": "schema:streetAddress" },
    "propertyPhone": { "@id": "schema:telephone" },
    "propertyRating": { "@id": "schema:starRating" },
    "propertyCountry": { "@id": "schema:addressCountry" },
    "propertyCity": { "@id": "schema:addressLocality" },
    "checkInDate": { "@id": "schema:checkinTime" },
    "checkOutDate": { "@id": "schema:checkoutTime" },
    "selectedNights": { "@id": "ares:selectedNights" },
    "totalRooms": { "@id": "ares:totalRooms" },
    "totalAdults": { "@id": "ares:totalAdults" },
    "totalChildren": { "@id": "ares:totalChildren" },
    "roomDetail": { "@id": "ares:roomDetail", "@container": "@list" },
    "roomTypeDescription": { "@id": "ares:roomTypeDescription" },
    "numberOfRooms": { "@id": "ares:numberOfRooms" },
    "roomType": { "@id": "ares:roomType" },
    "specialRemark": { "@id": "ares:specialRemark" },
    "contractComments": { "@id": "ares:contractComments" },
    "cancellationPolicyText": { "@id": "ares:cancellationPolicyText" },
    "cancellationDate": { "@id": "ares:cancellationDate" },
    "cancellationChargeAmount": { "@id": "ares:cancellationChargeAmount" },
    "cancellationChargeCurrency": { "@id": "ares:cancellationChargeCurrency" },
    "refundAmount": { "@id": "ares:refundAmount" },
    "refundCurrency": { "@id": "ares:refundCurrency" }
  }
}
